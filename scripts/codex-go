#!/usr/bin/env python3
"""Launch the installed Codex with an isolated provider overlay.

Everything is passed through to the real `codex` binary via `-c` overrides, so
your ~/.codex/config.toml and existing sessions stay untouched.

Usage:
  codex-go -C /path/to/project
  codex-go exec -C /path/to/project 'your task'
  codex-go resume SESSION_ID

Environment:
  CODEX_GO_MODEL      model slug (default: deepseek-flash)
  CODEX_GO_PROVIDER   provider id to define (default: opencode_go)
  CODEX_GO_BASE_URL   provider base url (default: https://opencode.ai/zen/go/v1)
  CODEX_GO_CATALOG    model catalog json (default: ./models.json next to this file)
  CODEX_GO_AUTH       auth command script (default: ./auth.py next to this file)
  CODEX_GO_REASONING  reasoning effort (default: high)
"""
import json
import os
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def main():
    codex = shutil.which("codex")
    if not codex:
        sys.exit("Codex is not installed or is missing from PATH")

    model = os.environ.get("CODEX_GO_MODEL", "deepseek-flash")
    provider = os.environ.get("CODEX_GO_PROVIDER", "opencode_go")
    base_url = os.environ.get("CODEX_GO_BASE_URL", "https://opencode.ai/zen/go/v1")
    catalog = Path(os.environ.get("CODEX_GO_CATALOG", ROOT / "models.json")).resolve()
    auth = Path(os.environ.get("CODEX_GO_AUTH", ROOT / "auth.py")).resolve()
    effort = os.environ.get("CODEX_GO_REASONING", "high")

    if not catalog.exists():
        sys.exit(f"Missing model catalog: {catalog} (see scripts/make-catalog.py)")

    overrides = [
        f"model={json.dumps(model)}",
        f"model_provider={json.dumps(provider)}",
        f"model_reasoning_effort={json.dumps(effort)}",
        f"model_catalog_json={json.dumps(str(catalog))}",
        f"model_providers.{provider}.name={json.dumps(provider)}",
        f"model_providers.{provider}.base_url={json.dumps(base_url)}",
        f'model_providers.{provider}.wire_api="responses"',
        f"model_providers.{provider}.requires_openai_auth=false",
        f'model_providers.{provider}.auth.command="/usr/bin/python3"',
        f"model_providers.{provider}.auth.args={json.dumps([str(auth)])}",
        f"model_providers.{provider}.auth.timeout_ms=5000",
        f"model_providers.{provider}.auth.refresh_interval_ms=300000",
    ]

    arguments = [codex]
    for override in overrides:
        arguments.extend(["-c", override])
    arguments.extend(sys.argv[1:])
    os.execv(codex, arguments)


if __name__ == "__main__":
    main()
